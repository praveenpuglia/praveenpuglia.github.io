---
---

<div class="site-header">
  <header class="main-header">
    <a href="/">
      <h3 class="main-header-logo bold">Praveen Puglia</h3>
    </a>
    <nav role="navigation" class="main-navigation" aria-label="Main Navigation">
      <ul class="navigation-links">
        <li class="navigation-link-item">
          <a class="navigation-link" href="/posts">Posts</a>
        </li>
        <li class="navigation-link-item">
          <a class="navigation-link" href="/games">Games</a>
        </li>
        <li class="navigation-link-item">
          <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
            <span class="toggle-slider"></span>
            <!-- Sun (Light mode) -->
            <span class="toggle-icon icon-light" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"/>
                <line x1="12" y1="1" x2="12" y2="3"/>
                <line x1="12" y1="21" x2="12" y2="23"/>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                <line x1="1" y1="12" x2="3" y2="12"/>
                <line x1="21" y1="12" x2="23" y2="12"/>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
              </svg>
            </span>
            <!-- Moon (Dark mode) -->
            <span class="toggle-icon icon-dark" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
              </svg>
            </span>
          </button>
        </li>
      </ul>
    </nav>
  </header>
</div>

<style>
  .theme-toggle {
    position: relative;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    cursor: pointer;
    padding: 0.25rem;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0;
    border-radius: 2rem;
    transition: border-color 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent-color);
  }

  .toggle-slider {
    position: absolute;
    width: 2rem;
    height: 2rem;
    background: var(--accent-color);
    border-radius: 50%;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    left: 0.25rem;
  }

  .toggle-icon {
    position: relative;
    z-index: 1;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .icon-light {
    color: var(--color-bg);
  }

  .icon-dark {
    color: var(--color-text-muted);
  }

  /* Dark mode: slider moves right, colors swap */
  :global([data-theme="dark"]) .toggle-slider {
    transform: translateX(2rem);
  }

  :global([data-theme="dark"]) .icon-light {
    color: var(--color-text-muted);
  }

  :global([data-theme="dark"]) .icon-dark {
    color: var(--color-bg);
  }

  /* System preference dark mode */
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .toggle-slider {
      transform: translateX(2rem);
    }

    :global(:root:not([data-theme="light"])) .icon-light {
      color: var(--color-text-muted);
    }

    :global(:root:not([data-theme="light"])) .icon-dark {
      color: var(--color-bg);
    }
  }
</style>

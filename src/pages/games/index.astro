---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/games.css";

const games = [
  {
    title: "Perpendicular",
    description: "Drag the arm and try to hit exactly 90 degrees. How precise are you?",
    href: "/games/perpendicular",
    avatar: `<line x1="50" y1="50" x2="95" y2="50" stroke="var(--color-text-muted)" stroke-width="10" stroke-linecap="butt" opacity="0.4" />
      <line x1="50" y1="50" x2="80" y2="15" stroke="var(--accent-color)" stroke-width="10" stroke-linecap="butt" />
      <circle cx="50" cy="50" r="5" fill="var(--color-text)" />`,
  },
  {
    title: "Bisect",
    description: "Find the exact midpoint of a line segment. Five rounds to prove your precision.",
    href: "/games/bisect",
    avatar: `<line x1="15" y1="70" x2="85" y2="30" stroke="var(--color-text-muted)" stroke-width="6" stroke-linecap="round" opacity="0.5" />
      <circle cx="50" cy="50" r="5" fill="var(--accent-color)" />`,
  },
  {
    title: "Halve",
    description: "Split a shape into two equal halves with a single cut.",
    href: "/games/halve",
    avatar: `<polygon points="30 70, 20 40, 40 15, 65 20, 80 45, 70 75, 50 85"
        fill="color-mix(in srgb, var(--accent-color) 15%, transparent)"
        stroke="var(--accent-color)" stroke-width="2" stroke-linejoin="round" />
      <line x1="25" y1="55" x2="75" y2="35"
        stroke="var(--color-text-muted)" stroke-width="1.5"
        stroke-dasharray="4 3" />`,
  },
];
---

<BaseLayout title="Games">
  <h1 class="title">Games</h1>
  <ul class="games-list">
    {
      games.map((game) => (
        <li class="game-card">
          <a href={game.href} class="game-card-link">
            <div class="game-card-avatar">
              <svg viewBox="0 0 100 100" aria-hidden="true" class="game-avatar" set:html={game.avatar} />
            </div>
            <div class="game-card-body">
              <h4>{game.title}</h4>
              <p>{game.description}</p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

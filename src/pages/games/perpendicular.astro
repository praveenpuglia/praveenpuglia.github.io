---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Perpendicular" description="Drag the arm and try to hit exactly 90 degrees.">
  <div class="game-wrapper">
    <h1 class="game-title">Perpendicular</h1>
    <p class="game-subtitle">Drag the arm to make a perfect right angle.</p>

    <div class="game-area" id="game-area">
      <svg
        id="game-svg"
        viewBox="10 20 480 260"
        class="game-svg"
        aria-label="Angle meter game"
      >
        <!-- Ruler tick marks on fixed arm -->
        <g id="fixed-ticks" class="ruler-ticks"></g>
        <!-- Ruler tick marks on movable arm -->
        <g id="movable-ticks" class="ruler-ticks"></g>

        <!-- Fixed arm (horizontal, pointing right) -->
        <line
          id="fixed-arm"
          x1="250"
          y1="250"
          x2="450"
          y2="250"
          class="arm fixed-arm"
        />

        <!-- Movable arm -->
        <line
          id="movable-arm"
          x1="250"
          y1="250"
          x2="450"
          y2="250"
          class="arm movable-arm"
        />

        <!-- Arc showing the angle -->
        <path id="angle-arc" class="angle-arc" d="" />

        <!-- Guide arm at perfect 90° — ghost of where the arm should be -->
        <rect
          id="guide-arm"
          x="241"
          y="50"
          width="18"
          height="200"
          class="guide-arm hidden"
        />

        <!-- Pivot point -->
        <circle cx="250" cy="250" r="8" class="pivot" />

        <!-- Drag handle on the movable arm tip -->
        <circle
          id="drag-handle"
          cx="450"
          cy="250"
          r="16"
          class="drag-handle"
        />
      </svg>

    </div>

    <div id="result" class="result hidden">
      <p class="result-angle" id="result-angle"></p>
      <p class="result-offset" id="result-offset"></p>
      <p class="result-rating" id="result-rating"></p>
      <button id="restart-btn" class="restart-btn">Play Again</button>
    </div>

    <p class="game-instruction" id="game-instruction">Drag the handle to set your angle, then release.</p>
  </div>
</BaseLayout>

<style>
  .game-wrapper {
    text-align: center;
    max-width: 540px;
    margin: 0 auto;
  }

  .game-title {
    margin-bottom: 0.25rem;
  }

  .game-subtitle {
    color: var(--color-text-muted);
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .game-area {
    position: relative;
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .game-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .arm {
    stroke-width: 18;
    stroke-linecap: butt;
  }

  .fixed-arm {
    stroke: var(--color-text-muted);
    opacity: 0.4;
  }

  .movable-arm {
    stroke: var(--accent-color);
    cursor: grab;
  }

  .movable-arm.dragging {
    cursor: grabbing;
  }

  .ruler-ticks :global(line) {
    stroke: var(--color-bg);
    stroke-width: 1;
    opacity: 0.5;
  }

  .angle-arc {
    fill: var(--accent-color);
    opacity: 0.15;
    stroke: var(--accent-color);
    stroke-width: 1.5;
    stroke-opacity: 0.4;
  }

  .pivot {
    fill: var(--color-text);
  }

  .drag-handle {
    fill: var(--accent-color);
    opacity: 0.3;
    cursor: grab;
    transition: opacity 0.15s ease;
  }

  .drag-handle:hover {
    opacity: 0.5;
  }

  .drag-handle.dragging {
    opacity: 0.6;
    cursor: grabbing;
  }

  .guide-arm {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
    stroke-dasharray: 6 4;
    opacity: 0.5;
    rx: 2;
  }

  .guide-arm.hidden {
    display: none;
  }

  .result {
    text-align: center;
    margin-top: 1rem;
  }

  .result.hidden {
    display: none;
  }

  .result-angle {
    font-family: var(--font-monospace);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
    line-height: 1.1;
  }

  .result-offset {
    font-size: 0.9rem;
    margin: 0.25rem 0 0;
    color: var(--color-text-muted);
  }

  .result-rating {
    font-size: 1rem;
    font-style: italic;
    margin: 0.75rem 0 0;
    color: var(--accent-color);
  }

  .restart-btn {
    margin-top: 1rem;
    padding: 0.5rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 1rem;
    background: var(--accent-color);
    color: var(--color-bg);
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .restart-btn:hover {
    opacity: 0.85;
  }

  .game-instruction {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: 1rem;
  }

  .game-instruction.hidden {
    display: none;
  }
</style>

<script is:inline>
function initPerpendicular() {
  var svg = document.getElementById('game-svg');
  if (!svg || svg.dataset.initialized) return;
  svg.dataset.initialized = 'true';

  var movableArm = document.getElementById('movable-arm');
  var dragHandle = document.getElementById('drag-handle');
  var angleArc = document.getElementById('angle-arc');
  var fixedTicks = document.getElementById('fixed-ticks');
  var movableTicks = document.getElementById('movable-ticks');
  var resultEl = document.getElementById('result');
  var resultAngle = document.getElementById('result-angle');
  var resultOffset = document.getElementById('result-offset');
  var resultRating = document.getElementById('result-rating');
  var restartBtn = document.getElementById('restart-btn');
  var guideArm = document.getElementById('guide-arm');
  var instruction = document.getElementById('game-instruction');

  var PIVOT_X = 250;
  var PIVOT_Y = 250;
  var ARM_LENGTH = 200;
  var DEG = 180 / Math.PI;

  var currentAngle = 0;
  var dragging = false;
  var locked = false;
  var audioCtx = null;
  var lastTickAngle = null;
  var TICK_EVERY = 2; // degrees between ticks

  function initAudio() {
    if (!audioCtx) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
  }

  function playTick() {
    if (!audioCtx) return;
    var now = audioCtx.currentTime;
    var osc = audioCtx.createOscillator();
    var gain = audioCtx.createGain();
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.type = 'square';
    osc.frequency.value = 1200;
    gain.gain.setValueAtTime(0.06, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.025);
    osc.start(now);
    osc.stop(now + 0.025);
  }

  function randomStartAngle() {
    var ranges = [[20, 70], [110, 160]];
    var range = ranges[Math.floor(Math.random() * ranges.length)];
    return range[0] + Math.random() * (range[1] - range[0]);
  }

  function setAngle(angleDeg) {
    currentAngle = angleDeg;
    var rad = -angleDeg / DEG;
    var tipX = PIVOT_X + ARM_LENGTH * Math.cos(rad);
    var tipY = PIVOT_Y + ARM_LENGTH * Math.sin(rad);

    movableArm.setAttribute('x2', tipX);
    movableArm.setAttribute('y2', tipY);
    dragHandle.setAttribute('cx', tipX);
    dragHandle.setAttribute('cy', tipY);

    updateArc(angleDeg);
    updateMovableTicks(rad);
  }

  function updateArc(angleDeg) {
    if (angleDeg <= 0.1) {
      angleArc.setAttribute('d', '');
      return;
    }
    var radius = 50;
    var startAngle = 0;
    var endAngle = -angleDeg / DEG;

    var startX = PIVOT_X + radius * Math.cos(startAngle);
    var startY = PIVOT_Y + radius * Math.sin(startAngle);
    var endX = PIVOT_X + radius * Math.cos(endAngle);
    var endY = PIVOT_Y + radius * Math.sin(endAngle);

    var largeArc = angleDeg > 180 ? 1 : 0;

    var d = 'M ' + PIVOT_X + ' ' + PIVOT_Y +
            ' L ' + startX + ' ' + startY +
            ' A ' + radius + ' ' + radius + ' 0 ' + largeArc + ' 0 ' + endX + ' ' + endY +
            ' Z';
    angleArc.setAttribute('d', d);
  }

  function generateTicks(groupEl, x1, y1, x2, y2) {
    groupEl.innerHTML = '';
    var dx = x2 - x1;
    var dy = y2 - y1;
    var length = Math.sqrt(dx * dx + dy * dy);
    var nx = -dy / length;
    var ny = dx / length;

    var tickSpacing = 15;
    var numTicks = Math.floor(length / tickSpacing);

    for (var i = 1; i <= numTicks; i++) {
      var t = (i * tickSpacing) / length;
      var px = x1 + dx * t;
      var py = y1 + dy * t;

      var tickLen = (i % 5 === 0) ? 7 : 4;

      var tick = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      tick.setAttribute('x1', px - nx * tickLen);
      tick.setAttribute('y1', py - ny * tickLen);
      tick.setAttribute('x2', px + nx * tickLen);
      tick.setAttribute('y2', py + ny * tickLen);
      groupEl.appendChild(tick);
    }
  }

  function updateMovableTicks(rad) {
    var tipX = PIVOT_X + ARM_LENGTH * Math.cos(rad);
    var tipY = PIVOT_Y + ARM_LENGTH * Math.sin(rad);
    generateTicks(movableTicks, PIVOT_X, PIVOT_Y, tipX, tipY);
  }

  function initFixedTicks() {
    generateTicks(fixedTicks, PIVOT_X, PIVOT_Y, PIVOT_X + ARM_LENGTH, PIVOT_Y);
  }

  function getPointerAngle(e) {
    var pt = svg.createSVGPoint();
    if (e.touches) {
      pt.x = e.touches[0].clientX;
      pt.y = e.touches[0].clientY;
    } else {
      pt.x = e.clientX;
      pt.y = e.clientY;
    }
    var svgPt = pt.matrixTransform(svg.getScreenCTM().inverse());

    var dx = svgPt.x - PIVOT_X;
    var dy = svgPt.y - PIVOT_Y;

    var rad = Math.atan2(dy, dx);
    var deg = -rad * DEG;

    if (deg < 0) deg = 0;
    if (deg > 180) deg = 180;

    return deg;
  }

  function onPointerDown(e) {
    if (locked) return;
    e.preventDefault();
    dragging = true;
    lastTickAngle = currentAngle;
    initAudio();
    movableArm.classList.add('dragging');
    dragHandle.classList.add('dragging');
  }

  function onPointerMove(e) {
    if (!dragging || locked) return;
    e.preventDefault();
    var angle = getPointerAngle(e);
    setAngle(angle);

    if (lastTickAngle === null || Math.abs(angle - lastTickAngle) >= TICK_EVERY) {
      playTick();
      lastTickAngle = angle;
    }
  }

  function onPointerUp() {
    if (!dragging || locked) return;
    dragging = false;
    locked = true;
    movableArm.classList.remove('dragging');
    dragHandle.classList.remove('dragging');
    showResult();
  }

  function showResult() {
    var offset = Math.abs(currentAngle - 90);

    resultAngle.textContent = currentAngle.toFixed(1) + '\u00B0';
    resultOffset.textContent = offset.toFixed(1) + '\u00B0 off from 90\u00B0';

    var rating;
    if (offset < 0.3) {
      rating = 'Are you a protractor?';
    } else if (offset < 1) {
      rating = 'Did you just... eyeball perfection?';
    } else if (offset < 3) {
      rating = 'Your geometry teacher would almost be proud.';
    } else if (offset < 7) {
      rating = 'Close enough for government work.';
    } else if (offset < 15) {
      rating = 'Were you even trying?';
    } else if (offset < 30) {
      rating = "That's... creative.";
    } else {
      rating = 'Sir, this is a right angle game.';
    }
    resultRating.textContent = rating;

    guideArm.classList.remove('hidden');
    resultEl.classList.remove('hidden');
    instruction.classList.add('hidden');
  }

  function restart() {
    locked = false;
    dragging = false;
    lastTickAngle = null;
    guideArm.classList.add('hidden');
    resultEl.classList.add('hidden');
    instruction.classList.remove('hidden');
    setAngle(randomStartAngle());
  }

  // Mouse events
  dragHandle.addEventListener('mousedown', onPointerDown);
  movableArm.addEventListener('mousedown', onPointerDown);
  document.addEventListener('mousemove', onPointerMove);
  document.addEventListener('mouseup', onPointerUp);

  // Touch events
  dragHandle.addEventListener('touchstart', onPointerDown, { passive: false });
  movableArm.addEventListener('touchstart', onPointerDown, { passive: false });
  document.addEventListener('touchmove', onPointerMove, { passive: false });
  document.addEventListener('touchend', onPointerUp);

  restartBtn.addEventListener('click', restart);

  // Initialize
  initFixedTicks();
  setAngle(randomStartAngle());
}

// Run on initial load
initPerpendicular();
// Re-run after Astro view transitions
document.addEventListener('astro:page-load', initPerpendicular);
</script>
